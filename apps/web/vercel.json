{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/rastrear/:publicId([a-f0-9]{64})",
      "destination": "https://origem-eletroagro.smilingfly2.chatgpt.site/rastrear/:publicId",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/neon-auth/:path*",
      "destination": "/api/neon-auth?__neonAuthPath=:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/rastrear/:publicId",
      "destination": "/index.html"
    },
    {
      "source": "/rastrear",
      "destination": "/index.html"
    }
  ]
}
